{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","environment","timezone","workdays_iso","workday_start","workday_end","member_digest_time","manager_report_time","reminder_minutes_before_due","early_threshold_minutes","poll_seconds","worker_tick_seconds","lease_seconds","slack_mode","restore_mode","private_base_url","allowed_client_cidrs","manager_user_id","backup_target"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"enum": ["development","test","pilot"]},
    "timezone": {"type": "string", "minLength": 1},
    "workdays_iso": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
    "workday_start": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "workday_end": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "member_digest_time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "manager_report_time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "reminder_minutes_before_due": {"type": "integer", "minimum": 1},
    "early_threshold_minutes": {"type": "integer", "minimum": 1},
    "poll_seconds": {"type": "integer", "minimum": 1},
    "worker_tick_seconds": {"type": "integer", "minimum": 1},
    "lease_seconds": {"type": "integer", "minimum": 1},
    "slack_mode": {"enum": ["off","dry_run","live"]},
    "restore_mode": {"type": "boolean"},
    "private_base_url": {"type": ["string","null"], "format": "uri"},
    "allowed_client_cidrs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "manager_user_id": {"type": ["string","null"]},
    "backup_target": {"type": ["string","null"]}
  }
}
